            },
            "fieldValue": {
              "id": "99168f85-42f9-4fe2-9cde-460e662ed4ab",
              "name": "resources.fields.purposes.joboffer_contract_type.values.permanent",
              "__typename": "fieldsvalues"
            },
            "location": null,
