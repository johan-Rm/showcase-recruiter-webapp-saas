# =============================================================================
#  showcase-recruiter-webapp-saas — Variables d'INFRASTRUCTURE (docker-compose)
# -----------------------------------------------------------------------------
#  Ce fichier est lu par docker-compose (PAS par Symfony) : il sert à créer le
#  conteneur Postgres, mapper les ports et résoudre les ${...} des compose.
#
#  Copie-le en `.env` (gitignoré) — ou lance `make dev-env`. Ne jamais committer
#  de secret : seuls les *.example sont versionnés.
# =============================================================================


# -----------------------------------------------------------------------------
#  Base de données (PostgreSQL)
# -----------------------------------------------------------------------------
#  ⚠️ La config BDD vit dans DEUX fichiers complémentaires :
#    1. ICI (.env racine)  → POSTGRES_* : CRÉE la base + le rôle dans le conteneur
#    2. api/.env           → DATABASE_URL : CONNECTE l'API à cette base
#  Les deux doivent concorder (même base / user / mot de passe).
# -----------------------------------------------------------------------------
POSTGRES_VERSION=17
POSTGRES_DB=showcase-recruiter-webapp-saas
POSTGRES_USER=showcase-recruiter-webapp-saas
POSTGRES_PASSWORD=change_me


# -----------------------------------------------------------------------------
#  Ports exposés sur l'hôte (dev)
# -----------------------------------------------------------------------------
DEV_API_PORT=18082
DEV_DB_PORT=5432
DEV_MAILPIT_UI_PORT=18025

# Proxy dev (Caddy) : sert les 4 espaces sur localhost, candidat.localhost,
# entreprise.localhost, admin.localhost. Mettre 80 pour des URLs sans port.
DEV_PROXY_PORT=8080

# Accès `localhost` littéral à l'espace entreprise, réservé aux callbacks OAuth
# (les fournisseurs refusent les sous-domaines de localhost). Cf. Caddyfile.dev.
DEV_OAUTH_PORT=8082


# -----------------------------------------------------------------------------
#  Stack d'un worktree (travail parallèle sur plusieurs espaces)
# -----------------------------------------------------------------------------
#  Ces trois variables restent VIDES dans l'arbre principal — leurs valeurs par
#  défaut décrivent déjà la stack de référence. Un worktree, lui, fait tourner sa
#  PROPRE stack en même temps : `scripts/worktree-init.sh <espace>` génère son
#  `.env` avec un bloc de ports et un domaine à lui.
#
#  Un espace = un décalage de 100 sur tous les ports :
#
#    espace         proxy  oauth  api    db    mailpit  domaine
#    (principal)     8080   8082  18082  5432   18025   localhost
#    api             8180   8182  18182  5532   18125   wt-api.localhost
#    entreprise      8280   8282  18282  5632   18225   wt-entreprise.localhost
#    candidat        8380   8382  18382  5732   18325   wt-candidat.localhost
#    admin           8480   8482  18482  5832   18425   wt-admin.localhost
#    public          8580   8582  18582  5932   18525   wt-public.localhost
#    socle-webapp    8680   8682  18682  6032   18625   wt-socle-webapp.localhost
#    outillage       8780   8782  18782  6132   18725   wt-outillage.localhost
#
#  COMPOSE_PROJECT_NAME  Sans lui, docker-compose nomme le projet d'après le
#                        dossier — `api` pour worktree/api. Illisible dans
#                        `docker ps`, et exposé aux collisions avec un autre repo.
#  DEV_BASE_DOMAIN       Domaine servi par Caddy. Un domaine par stack et pas
#                        seulement un port : les cookies de session ignorent le
#                        port, deux stacks servant le même espace se
#                        déconnecteraient mutuellement.
#  DEV_SPACE             Espace Nuxt allumé par `make dev-up-space` (un seul par
#                        stack : chaque serveur Nuxt pèse 0,7 à 1,3 Go).
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=
DEV_BASE_DOMAIN=
DEV_SPACE=


# -----------------------------------------------------------------------------
#  Domaine (preprod / prod)
# -----------------------------------------------------------------------------
#  Domaine unique. Sous-domaines : api. / candidat. / entreprise. / admin. / docs. / swagger. / dev-book.
#  ⚠️ Dans la copie PREPROD du VPS : BASE_DOMAIN=preprod.showcase-recruiter-webapp-saas.example.
#  Le proxy frontal (docker-compose.proxy.yml) garde lui BASE_DOMAIN=showcase-recruiter-webapp-saas.example.
BASE_DOMAIN=showcase-recruiter-webapp-saas.example


# -----------------------------------------------------------------------------
#  Webapp (session BFF nuxt-auth-utils) — preprod / prod
# -----------------------------------------------------------------------------
#  Secret de scellement du cookie de session (≥ 32 caractères aléatoires).
#  Distinct par environnement. Générer : openssl rand -base64 32
NUXT_SESSION_PASSWORD=change_me_32_chars_minimum_random

# -----------------------------------------------------------------------------
#  Webapp — Google Places (autocomplétion d'adresse à l'inscription entreprise)
# -----------------------------------------------------------------------------
#  Clé Google Places API (New), utilisée UNIQUEMENT côté serveur (proxy BFF, jamais
#  exposée au client). Restreindre la clé (referrer/IP + APIs autorisées).
#  Vide → l'autocomplétion se désactive et le formulaire retombe en saisie manuelle.
NUXT_GOOGLE_PLACES_API_KEY=

# -----------------------------------------------------------------------------
#  Webapp — Claude (recherche assistée de l'espace entreprise)
# -----------------------------------------------------------------------------
#  Clé Anthropic, utilisée UNIQUEMENT côté serveur (BFF /api/ai/parse-search) : la phrase
#  du recruteur est traduite en critères, jamais les profils. Chaque recherche = un appel.
#  Vide → la recherche assistée se désactive (la recherche par critères reste offerte).
NUXT_ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
#  Webapp — Social login (OIDC Google / LinkedIn)
# -----------------------------------------------------------------------------
#  Le client_id sert AUSSI côté API (GOOGLE_OIDC_CLIENT_ID / LINKEDIN_OIDC_CLIENT_ID) :
#  c'est l'audience attendue de l'id_token. Le client_secret, lui, ne vit QUE ici —
#  il echange le code contre l'id_token et ne doit jamais atteindre le navigateur.
#  Une app OAuth PAR ENVIRONNEMENT : un secret de preprod qui fuite ne touche pas la prod.
#  Vides -> le fournisseur est masque et le tunnel e-mail reste entier.
NUXT_GOOGLE_OIDC_CLIENT_ID=
NUXT_GOOGLE_OIDC_CLIENT_SECRET=
NUXT_LINKEDIN_OIDC_CLIENT_ID=
NUXT_LINKEDIN_OIDC_CLIENT_SECRET=


# -----------------------------------------------------------------------------
#  Jarvi (import candidats) — preprod / prod
# -----------------------------------------------------------------------------
#  Clé API Jarvi (PRIVÉE) : requise par `app:jarvi:profiles:import`. Vide = pas d'import.
JARVI_API_KEY=


# -----------------------------------------------------------------------------
#  Proxy frontal (docker-compose.proxy.yml) — basic auth preprod
# -----------------------------------------------------------------------------
#  Hash bcrypt : docker run --rm caddy:2-alpine caddy hash-password --plaintext '...'
PREPROD_BASIC_AUTH_USER=showcase-recruiter-webapp-saas
PREPROD_BASIC_AUTH_HASH=change_me_bcrypt_hash

#  Docs d'équipe (docs. / swagger. / dev-book.) — protégées en prod ET preprod.
#  Servent AUSSI aux maquettes `/artefacts/*` sur la preprod publique : même public (l'équipe et
#  le client), un seul secret à faire tourner.
DOCS_BASIC_AUTH_USER=showcase-recruiter-webapp-saas-team
DOCS_BASIC_AUTH_HASH=change_me_bcrypt_hash


# -----------------------------------------------------------------------------
#  Notification de déploiement (preprod / prod)
# -----------------------------------------------------------------------------
#  E-mail envoyé par `make preprod-deploy` UNE FOIS TOUT PASSÉ (scripts/notify-deploy.sh).
#  Vides → la notification est ignorée et le déploiement se termine normalement.
#
#  ⚠️ Ce canal ne passe PAS par le mailer de l'application : en preprod, MAILER_DSN pointe sur
#  Mailpit et rien n'en sort. Il emprunte le compte mail du domaine — le même dont la PROD aura
#  besoin en MAILER_DSN. Aucun service tiers : les boîtes de showcase-recruiter-webapp-saas.example sont chez OVH et le SPF
#  du domaine y autorise déjà l'envoi, donc le message part authentifié.
#
#  DEPLOY_NOTIFY_TO             Un ou plusieurs destinataires, séparés par des virgules. Les espaces
#                               autour sont tolérés, et la forme « Nom <adresse> » est acceptée :
#                                 DEPLOY_NOTIFY_TO=moi@exemple.fr, Johan REMY <lui@exemple.fr>
#                               Tous se voient mutuellement dans l'en-tête du message.
#  DEPLOY_NOTIFY_SMTP_USER      Adresse complète de la boîte émettrice (= identifiant SMTP).
#  DEPLOY_NOTIFY_SMTP_PASSWORD  Mot de passe de cette boîte (PRIVÉ) — cf. l'avertissement ci-dessous.
#  DEPLOY_NOTIFY_SMTP_URL       Serveur d'envoi. Défaut : smtps://ssl0.ovh.net:465 (OVH). Le port
#                               465 est celui de la soumission chiffrée ; le 25, souvent fermé par
#                               les hébergeurs, n'est pas utilisé.
#  DEPLOY_NOTIFY_FROM           Expéditeur affiché. Défaut : « showcase-recruiter-webapp-saas <DEPLOY_NOTIFY_SMTP_USER> ».
#
#  Les ACCÈS DE RECETTE joints au mail ne se règlent pas ici : ils sont écrits dans
#  `scripts/notify-deploy.sh`, identiques sur toute machine où ce script tourne. Le bloc ne part que
#  si BASE_DOMAIN commence par « preprod. » — ailleurs, production comprise, il est écarté et le
#  refus s'affiche pendant le déploiement.
#
#  ⚠️ ENTOURER LE MOT DE PASSE D'APOSTROPHES. Ce fichier est lu par un shell : sans elles, un `$`
#  fait disparaître la suite du mot de passe et un guillemet vide la valeur ENTIÈRE — sans aucun
#  message d'erreur, l'envoi échoue simplement en « authentification refusée ».
#      ✅  DEPLOY_NOTIFY_SMTP_PASSWORD='aB3x$z%25y"suite'
#      ❌  DEPLOY_NOTIFY_SMTP_PASSWORD=aB3x$z%25y"suite
#  (Ces variables n'étant lues par AUCUN compose, la règle du `$` doublé qui vaut pour les hash
#  basic-auth ci-dessus ne s'applique pas ici : apostrophes seulement.)
DEPLOY_NOTIFY_TO=
DEPLOY_NOTIFY_SMTP_USER=
DEPLOY_NOTIFY_SMTP_PASSWORD=
DEPLOY_NOTIFY_SMTP_URL=
DEPLOY_NOTIFY_FROM=


# -----------------------------------------------------------------------------
#  Docker (dev) — UID/GID pour aligner les droits fichiers conteneur ↔ hôte
# -----------------------------------------------------------------------------
DOCKER_UID=1000
DOCKER_GID=1000
