{
    // MSI en politique ratchet : démarre à 0, ne redescend jamais (cf. docs/showcase-recruiter-webapp-saas/content/3.quality).
    $schema: 'vendor/infection/infection/resources/schema.json',
    source: {
        directories: ['src'],
        excludes: ['Kernel.php'],
    },
    mutators: {
        '@default': true,
    },
    minMsi: 0,
    minCoveredMsi: 0,
    logs: {
        text: 'var/infection.log',
    },
}
