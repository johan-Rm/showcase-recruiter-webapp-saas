# Surcharges de l'environnement Symfony `prod` (non-secret). Copier en `api/.env.prod`
# (NON versionné) sur le VPS et compléter. Chargé par-dessus .env quand APP_ENV=prod.
#
# ⚠️ Le STAGING (preprod) tourne AUSSI en APP_ENV=prod (pas d'env custom) → il utilise
# ce même fichier, mais rempli avec les valeurs *.preprod.showcase-recruiter-webapp-saas.example (voir variante ci-dessous).
#
# SECRETS (mot de passe DB, APP_SECRET, JWT_PASSPHRASE) : fournis par l'environnement
# (docker-compose / secret manager) ou un `api/.env.prod.local` NON versionné. Jamais ici.

# ─── PROD (showcase-recruiter-webapp-saas.example) ───
DEFAULT_URI=https://api.showcase-recruiter-webapp-saas.example
APP_BASE_URL=https://entreprise.showcase-recruiter-webapp-saas.example

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https://([a-z0-9-]+\.)?showcase-recruiter-webapp-saas\.example$'
###< nelmio/cors-bundle ###

# ─── Variante STAGING / preprod (à utiliser À LA PLACE des 3 valeurs ci-dessus sur le VPS preprod) ───
# DEFAULT_URI=https://api.preprod.showcase-recruiter-webapp-saas.example
# APP_BASE_URL=https://entreprise.preprod.showcase-recruiter-webapp-saas.example
# CORS_ALLOW_ORIGIN='^https://([a-z0-9-]+\.)?preprod\.showcase-recruiter-webapp-saas\.example$'

# Fournis par l'environnement (ne pas committer de valeur réelle) :
# DATABASE_URL="postgresql://USER:PASSWORD@db:5432/showcase-recruiter-webapp-saas?serverVersion=17&charset=utf8"
# APP_SECRET=__CHANGER__
# JWT_PASSPHRASE=__CHANGER__
