# ─────────────────────────────────────────────────────────────────────────────
# Template DEV (SEUL fichier versionné pour le dev). Copié en `api/.env` par
# `make dev-env`. Politique du projet : seuls les *.example sont versionnés ;
# les vrais .env* sont locaux. NE JAMAIS committer de secret réel ici.
# Symfony charge .env, puis .env.$APP_ENV (cf. .env.test/.preprod/.prod.example).
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=dev
APP_SECRET=showcase_recruiter_webapp_saas_dev_change_me
APP_DEBUG=1

APP_SHARE_DIR=var/share

# Hôte "db" = service docker-compose. Hors Docker : remplacer par 127.0.0.1.
DATABASE_URL="postgresql://showcase-recruiter-webapp-saas:change_me@db:5432/showcase-recruiter-webapp-saas?serverVersion=17&charset=utf8"

DEFAULT_URI=http://localhost
# Un host par espace (une build par espace) : le magic link renvoie sur l'espace du destinataire.
APP_BASE_URL=http://entreprise.localhost:8080
APP_CANDIDATE_BASE_URL=http://candidat.localhost:8080
APP_COMPANY_BASE_URL=http://entreprise.localhost:8080
MAGIC_LINK_TTL_MINUTES=30

# Social login (OIDC) — client_id de chaque fournisseur = audience attendue de l'id_token. SEUL
# secret côté API (émetteur et JWKS sont des constantes publiques câblées en dur). Vide → fournisseur
# « non configuré » : tout id_token échoue à l'audience (401) tant qu'aucun client_id n'est fourni. Le
# client_secret OAuth, lui, ne vit PAS ici : il reste côté BFF Nuxt, qui mène le flux redirect/callback.
GOOGLE_OIDC_CLIENT_ID=
LINKEDIN_OIDC_CLIENT_ID=

###> symfony/messenger ###
# File des e-mails, en base. `auto_setup=0` : la table n'est pas créée à la volée par
# le premier envoi — elle l'est explicitement (make dev-schema / prod-deploy).
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Doit correspondre à la passphrase du keypair généré (make dev-jwt).
JWT_PASSPHRASE=change_me
###< lexik/jwt-authentication-bundle ###

###> symfony/mailer ###
MAILER_DSN=smtp://mailpit:1025
# Expéditeur de TOUS les e-mails transactionnels. Le TLD `.test` ne sort pas d'ici : en preprod et en
# prod, une vraie adresse du domaine d'envoi — sans quoi SPF et DKIM ne peuvent rien signer.
MAILER_FROM="Shortlist <no-reply@showcase-recruiter-webapp-saas.test>"
###< symfony/mailer ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$|^https://([a-z0-9-]+\.)?showcase-recruiter-webapp-saas\.example$'
###< nelmio/cors-bundle ###

###> showcase-recruiter-webapp-saas/jarvi ###
# Clé PRIVÉE : la renseigner uniquement dans api/.env (local) — jamais ici.
JARVI_API_BASE_URL="https://functions.prod.jarvi.tech/v1/public-api/rest/v2/"
JARVI_GRAPHQL_URL="https://functions.prod.jarvi.tech/v1/public-api/graphql"
JARVI_API_KEY=""
JARVI_SHOWCASE_RECRUITER_WEBAPP_SAAS_PROJECT_ID="00000000-0000-4000-8000-000000000001"
# Sync Organization → company Jarvi (tâche 023). Désactivée par défaut : aucun appel Jarvi
# depuis l'onboarding/validation sans feu vert explicite.
JARVI_COMPANY_SYNC_ENABLED=false
JARVI_RECRUITER_PROJECT_ID="00000000-0000-4000-8000-000000000003"
###< showcase-recruiter-webapp-saas/jarvi ###

###> showcase-recruiter-webapp-saas/anthropic ###
# Clé PRIVÉE réservée à l'enrichissement du vocabulaire (app:vocabulary:enrich) : la renseigner
# uniquement dans api/.env (local) — jamais ici. Le LLM ne tourne QUE dans cette commande rare et
# manuelle ; le pipeline quotidien harvest + import est sans LLM.
ANTHROPIC_API_KEY=""
ANTHROPIC_VOCABULARY_MODEL="claude-opus-4-8"
# Seuil de fréquence (nb de profils) sous lequel un terme n'est pas soumis, et taille de lot.
VOCABULARY_ENRICH_MIN_FREQUENCY=3
VOCABULARY_ENRICH_BATCH_SIZE=80
# Regroupement sémantique des écoles (app:school:group) : DÉSACTIVÉ jusqu'à nouvel ordre. La récolte
# a montré que l'égalité de chaîne ne fusionne que 3,2 % des noms ; le reste exige un LLM sur ~2 366
# entrées, pour un filtre par école dont la valeur produit n'est pas confirmée. Passer à 1 pour lever
# le verrou une fois la décision prise.
SCHOOL_GROUPING_ENABLED=0
VOCABULARY_SCHOOL_MIN_FREQUENCY=1
VOCABULARY_SCHOOL_BATCH_SIZE=100
###< showcase-recruiter-webapp-saas/anthropic ###

###> showcase-recruiter-webapp-saas/vocabulary ###
# Concepts proches (app:vocabulary:similarity) — déterministe, aucune clé requise.
# Profils communs minimum, puis score NPMI minimum : mesuré sur le vivier, 0.3 empêche un concept
# très fréquent (« Communication ») de ressortir proche de tout.
VOCABULARY_SIMILARITY_MIN_COOCCURRENCES=4
VOCABULARY_SIMILARITY_MIN_NPMI=0.3
###< showcase-recruiter-webapp-saas/vocabulary ###
