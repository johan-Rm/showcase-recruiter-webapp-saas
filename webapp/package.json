{
  "name": "webapp",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:public": "SHOWCASE_RECRUITER_WEBAPP_SAAS_SPACE=public nuxt dev",
    "dev:candidat": "SHOWCASE_RECRUITER_WEBAPP_SAAS_SPACE=candidat nuxt dev",
    "dev:entreprise": "SHOWCASE_RECRUITER_WEBAPP_SAAS_SPACE=entreprise nuxt dev",
    "dev:admin": "SHOWCASE_RECRUITER_WEBAPP_SAAS_SPACE=admin nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "quality-check": "bun run quality-lint-check && bun run quality-format-check && bun run quality-type-check && bun run quality-conventions-check && bun run quality-test",
    "quality-test": "vitest run",
    "quality-conventions-check": "bun run scripts/ci/verify-conventions.ts",
    "quality-generate-schemas": "openapi-typescript ${SHOWCASE_RECRUITER_WEBAPP_SAAS_OPENAPI_SOURCE:-../api/openapi.json} --output shared/types/api.ts && bun run scripts/ci/generate-constraints.ts",
    "quality-contracts-check": "bun run quality-generate-schemas && git diff --exit-code -- shared/types/api.ts shared/types/organization-constraints.ts",
    "quality-lint-check": "eslint .",
    "quality-lint-fix": "eslint . --fix",
    "quality-format-check": "prettier --check .",
    "quality-format-fix": "prettier --write .",
    "quality-type-check": "bun run scripts/ci/type-check-spaces.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@nuxt/icon": "^2.3.1",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/device": "^4.0.0",
    "@nuxtjs/i18n": "^10.4.0",
    "@pinia/nuxt": "^0.11.3",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "nuxt": "^4.4.8",
    "nuxt-auth-utils": "^0.5.29",
    "pinia": "^3.0.4",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.116",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/hints": "^1.1.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "eslint": "^10.6.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.6",
    "yaml": "^2.9.0"
  }
}
