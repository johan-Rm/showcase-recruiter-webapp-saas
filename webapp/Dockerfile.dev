# Nuxt dev — monté en volume par docker-compose.dev.yml (hot reload).
FROM oven/bun:1

WORKDIR /app

# Les sources arrivent par bind mount ; node_modules vit dans un volume anonyme.
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

EXPOSE 3000

CMD ["bun", "run", "dev", "--host", "0.0.0.0", "--port", "3000"]
